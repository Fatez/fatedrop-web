# Canonical public URL used for metadata, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local development stores validated leads in an ignored NDJSON file.
FATEDROP_LEAD_STORE=file
FATEDROP_LEAD_FILE=data/beta-leads.ndjson

# Hosted option: set FATEDROP_LEAD_STORE=postgres and provide a managed
# PostgreSQL connection string after running database/postgres.sql.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
