# Canonical public URL used for metadata, redirects, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical FateDrop Signal Engine used by server-side network search.
# Override this if the Cloud service moves; the production Railway URL is the code fallback.
FATEDROP_SIGNAL_ENGINE_URL=https://fatedrop-cloud-production.up.railway.app
# Server-only bearer token for private Signal Engine diagnostics such as /api/signal-health.
# Use the same secret value as Cloud FATEDROP_SIGNAL_API_TOKEN. Never expose it as NEXT_PUBLIC_*.
# FATEDROP_SIGNAL_API_TOKEN=replace-with-signal-api-token

# Fate Trader is a canonical Fate Network product. Web no longer hides it behind a public build flag;
# Cloud authentication and endpoint availability remain authoritative at runtime.

# Beta lead storage.
FATEDROP_LEAD_STORE=file
FATEDROP_LEAD_FILE=data/beta-leads.ndjson

# FateDrop ID/account storage. Local development can use the ignored JSON file;
# hosted production should use PostgreSQL.
FATEDROP_ACCOUNT_STORE=file
FATEDROP_ACCOUNT_FILE=data/accounts.json

# Hosted PostgreSQL: run database/postgres.sql, then set both stores to postgres.
# FATEDROP_LEAD_STORE=postgres
# FATEDROP_ACCOUNT_STORE=postgres
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Stripe collector subscription. FateDrop Plus is the only public paid collector tier.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PLUS=price_...
# Optional legacy compatibility only; no new Pro checkout uses this price.
# STRIPE_PRICE_PRO=price_...
# Set false for a no-card 7-day trial; missing payment method cancels at trial end.
FATEDROP_TRIAL_REQUIRE_CARD=true

# Discord account linking and Premium role sync.
# Keep false until the server is ready to be advertised publicly.
NEXT_PUBLIC_DISCORD_ENABLED=false
# The OAuth redirect URI must be: <NEXT_PUBLIC_SITE_URL>/api/discord/callback
# Discord OAuth requests identify + guilds.join so one linked FateDrop ID can join
# the configured server and receive/remove the Premium role from the shared entitlement.
# DISCORD_CLIENT_ID=...
# DISCORD_CLIENT_SECRET=...
# DISCORD_BOT_TOKEN=...
# DISCORD_GUILD_ID=...
# DISCORD_PREMIUM_ROLE_ID=...

# Dashboard metric/audit storage. Defaults to FATEDROP_ACCOUNT_STORE when omitted.
FATEDROP_METRIC_STORE=file
FATEDROP_METRIC_FILE=data/dashboard-metrics.json

# Shared secret used by FateDrop Cloud to POST persisted network snapshots and
# app activity into the website metric ledger. Use a long random production value.
# FATEDROP_METRICS_INGEST_SECRET=replace-with-a-long-random-secret

# Canonical mobile push dispatcher. Keep OFF until a physical-device token has
# been registered and the isolated alert branch has passed production validation.
FATEDROP_PUSH_DISPATCH_ENABLED=false
# Optional: required only if enhanced Expo push security is enabled in EAS.
# EXPO_ACCESS_TOKEN=replace-with-expo-access-token
