# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the documented template is safe to commit)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/.sites-runtime/
/outputs/
/work/

# local FateDrop lead storage
/data/beta-leads.ndjson
/data/beta-leads.json

# local FateDrop account/session storage
/data/accounts.json
/data/accounts.json.*.tmp

# local Koru & Friends companion selection storage
/data/fatedrop-avatars.json
/data/fatedrop-avatars.json.*.tmp

# local FateDrop dashboard metric/audit storage
/data/dashboard-metrics.json
/data/dashboard-metrics.json.*.tmp

# OpenNext
.open-next

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
