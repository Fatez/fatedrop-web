{
  "name": "fatedrop-web",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone FateDrop website source project.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
